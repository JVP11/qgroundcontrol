import QtQuick
import QtQuick3D

Node {
    id: node

    // Resources
    PrincipledMaterial {
        id: color_material
        objectName: "color"
        baseColor: "#ff000000"
        roughness: 0.55
        alphaMode: PrincipledMaterial.Opaque
    }
    PrincipledMaterial {
        id: color_material3
        objectName: "color"
        baseColor: "#ffcfcfd2"
        roughness: 0.55
        alphaMode: PrincipledMaterial.Opaque
    }

    // Nodes:
    Model {
        id: nodes_0_
        objectName: "nodes[0]"
        source: "meshes/asthra_drone_prop.mesh"
        materials: [
            color_material,
            color_material3
        ]
    }

}
